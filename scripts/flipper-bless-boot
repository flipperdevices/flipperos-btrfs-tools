#!/bin/sh
# flipper-bless-boot - the boot worked, so stop counting it. Removes the BLS boot counter from the
# entry this system booted from, which the spec calls making it 'good'.
#
# Run once per boot by flipper-bless-boot.service, which requires boot-complete.target. What that
# target means is Debian's own judgement, not ours: with systemd-boot-check-no-failures.service
# enabled it is only reached when no unit failed, so a boot that comes up without its panel or
# without its network never blesses the kernel that did it.
#
# Which entry booted is on the kernel command line, as flipper.entry=<id>: nothing else in a
# running system says which of a profile's entries it came from. A boot that PIVOTED has the
# command line of whatever was running before it -- a pivot boots no kernel -- so boot-profile
# leaves the id in /run/flipper-boot-entry as well, and that is read when the command line says
# nothing. Missing counter, missing id or missing file are all quiet successes: an entry with no
# counter is already good, and there is nothing to repair.
set -eu
[ -r /usr/lib/flipper-blsname.sh ] || { echo "flipper-bless-boot: /usr/lib/flipper-blsname.sh not found" >&2; exit 1; }
. /usr/lib/flipper-blsname.sh
[ -r /usr/lib/flipper-rootinfo.sh ] || { echo "flipper-bless-boot: /usr/lib/flipper-rootinfo.sh not found" >&2; exit 1; }
. /usr/lib/flipper-rootinfo.sh

ENTRIES="${FLIPPER_ENTRIES:-/boot/loader/entries}"
NOTE="${FLIPPER_ENTRY_NOTE:-/run/flipper-boot-entry}"

id=""
for w in $(cat /proc/cmdline 2>/dev/null); do
    case "$w" in flipper.entry=*) id=${w#flipper.entry=} ;; esac
done
if [ -z "$id" ] && [ -r "$NOTE" ]; then
    read -r id < "$NOTE" || id=""
fi

# Neither said anything, which is what a pivot leaves: it boots no kernel, so the command line is
# the one already running, and the note in /run does not survive init's shutdown pass and
# switch_root. Work it out instead -- the kernel this system is running and the subvolume it is on
# name one entry between them, since an entry id is built from exactly those two things. More than
# one match would mean duplicate entries, and then guessing is worse than doing nothing.
if [ -z "$id" ]; then
    sv="$(booted_subvol)"; rel="$(uname -r)"
    hits=""
    for f in "$ENTRIES"/*.conf; do
        [ -f "$f" ] || continue
        [ "$(entry_subvol_of "$f")" = "$sv" ] || continue
        [ "$(sed -n "s/^version[[:space:]]\{1,\}//p" "$f" | head -n1)" = "$rel" ] || continue
        hits="$hits $(entry_id_of "$f")"
    done
    set -- $hits
    case $# in
        0) echo "flipper-bless-boot: no entry for $rel in ${sv:-this root}, nothing to bless"; exit 0 ;;
        1) id=$1; echo "flipper-bless-boot: no note from a pivot, so $id is what $rel in $sv came from" ;;
        *) echo "flipper-bless-boot: $# entries claim $rel in $sv ($hits), not guessing" >&2; exit 0 ;;
    esac
fi
case "$id" in *..*|*/*) echo "flipper-bless-boot: refusing an entry id with a path in it: $id" >&2; exit 1 ;; esac

blessed=0
for f in $(entry_files_for "$id"); do
    counter="$(entry_counter_of "$f")"
    [ -n "$counter" ] || continue
    mv -f "$f" "$ENTRIES/$id.conf"
    echo "flipper-bless-boot: $id booted cleanly, counter $counter removed"
    blessed=1
done
[ "$blessed" = 1 ] || echo "flipper-bless-boot: $id carries no counter, already good"
exit 0
