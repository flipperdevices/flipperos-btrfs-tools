#!/bin/sh
# boot-profile <@profile> - kexec directly into a bootable PROFILE (as listed by list-profiles),
# skipping the firmware/U-Boot cycle. Reads the profile's BLS entry for the kernel, initrd and
# cmdline from the filesystem that profile is on rather than from /boot, so `-d` boots an SD card's
# profile with the card's own kernel; assembles its device tree (the booted profile's is the live
# one, any other profile's is the board base dtb + the entry's overlays via fdtoverlay); loads it
# with kexec and hands over:
# `systemctl kexec` where systemd is running (clean shutdown, nothing reserved), `kexec -e` where
# it is not, which is an initramfs. --dry-run loads then unloads instead.
set -eu
[ -r /usr/lib/flipper-btrfs.sh ] || { echo "Error: /usr/lib/flipper-btrfs.sh not found" >&2; exit 1; }
. /usr/lib/flipper-btrfs.sh

usage() {
    cat <<EOF
Usage: boot-profile [--dry-run] [-d|--device DEV] <@profile>
  kexec into the profile: load its BLS kernel/initrd/dtb, then hand over: systemctl kexec
  under systemd, kexec -e without it.
  --dry-run   assemble + load with kexec, then unload: validates without rebooting
$HELP_DEVICE
EOF
}

dry=0
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)   dry=1 ;;
        -d|--device) shift; need_device_arg "$#"; ROOTDEV=$1 ;;
        --device=*)  ROOTDEV=${1#*=} ;;
        -h|--help)   usage; exit 0 ;;
        --)          shift; break ;;
        -?*)         echo "Error: unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)           break ;;
    esac
    shift
done
[ $# -ge 1 ] || { usage >&2; exit 1; }
arg=$1
case "$arg" in *..*|/*) die "Invalid name: $arg" ;; esac

need_root
command -v kexec     >/dev/null 2>&1 || die "kexec not installed (kexec-tools)"
command -v fdtoverlay >/dev/null 2>&1 || die "fdtoverlay not installed"

# BLS paths are top-level (/@X/...); read them under a subvolid=5 mount so this works for any
# profile, booted or not.
mount_top

# The entries belong to the filesystem the profile lives on, not to the one we booted from. For the
# booted filesystem $TOP/boot is the same subvolume that /boot already is, so this is the same file.
# For any other -- an SD card written with our own image -- it is that card's own entries, which is
# the only place its paths resolve: a card carries its own kernels, so an entry read from /boot
# names a version the card does not have, and profile names repeat across filesystems, so the wrong
# entry is found rather than none.
ENTRIES=$TOP/boot/loader/entries
# newest entry (highest kernel version sorts last) whose cmdline mounts this subvol
entry=$(grep -lE "rootflags=subvol=$arg( |\$)" "$ENTRIES"/*.conf 2>/dev/null | sort | tail -n1)
[ -n "$entry" ] || die "No boot entry for $arg (see list-profiles)"
val() { sed -n "s/^$1[[:space:]]\{1,\}//p" "$entry" | head -n1; }
K_REL=$(val linux); I_REL=$(val initrd); OPTS=$(val options)
DT_REL=$(val devicetree); DTDIR_REL=$(val devicetreedir); OVL_REL=$(val devicetree-overlay)
[ -n "$K_REL" ]  || die "boot entry has no 'linux' line"
[ -n "$OPTS" ]   || die "boot entry has no 'options' line"
K="$TOP$K_REL"; I="$TOP$I_REL"
[ -f "$K" ] || die "kernel not found: $K_REL"
[ -z "$I_REL" ] || [ -f "$I" ] || die "initrd not found: $I_REL"

# Graft this machine's /memory node onto an assembled tree.
#
# A shipped dtb describes the board, not the board's RAM: U-Boot writes /memory at every
# cold boot from what the SoC reports, and a BLS entry cannot carry it. Without it a
# kernel has no memory at all and dies before it can initialise a console, which is a
# boot that hangs and says nothing. That node is also what keeps firmware safe: it starts
# at 0x40200000 while ATF loads below that, so the window handed to Linux excludes it.
#
# The live reserve map is deliberately NOT copied. It describes the boot that is running:
# measured on this board it is exactly the length of the initramfs U-Boot loaded, so it is
# a fact about that boot's initrd and not about the machine. kexec tells the new kernel
# where its own initrd is.
#
# Grafted rather than taking the live tree whole, because a tree belongs to its kernel:
# every entry names the devicetreedir installed beside the kernel it boots, and the live
# tree is whatever kernel is running now. RAM is a fact about the machine and survives
# that difference.
#
# Best-effort, but never silent: a failure warns and the boot goes on, since a tree with a
# memory node of its own is fine without us. Saying nothing is what let a broken splice sit
# in this function through several hangs, each looking exactly like the bug it fixes.
say() {
    echo "boot-profile: $*" >&2
    [ -w /dev/kmsg ] && echo "boot-profile: $*" > /dev/kmsg 2>/dev/null
    return 0
}

graft_warn() { say "$*, booting without this machine's memory node"; }
graft_firmware_memory() {  # $1 = assembled dtb, edited in place
    [ -r /sys/firmware/fdt ] || return 0
    # A tree that names its own memory needs nothing from us.
    ! fdtget -l "$1" / 2>/dev/null | grep -qE '^memory(@|$)' || return 0
    command -v dtc >/dev/null 2>&1 || { graft_warn "no dtc"; return 0; }

    _live_dts=$(mktemp /tmp/boot-profile.XXXXXX.live.dts)
    _asm_dts=$(mktemp /tmp/boot-profile.XXXXXX.asm.dts)
    _new_dts=$(mktemp /tmp/boot-profile.XXXXXX.new.dts)
    _new_dtb=$(mktemp /tmp/boot-profile.XXXXXX.new.dtb)
    TOP_TMPFILES="${TOP_TMPFILES:-} $_live_dts $_asm_dts $_new_dts $_new_dtb"
    dtc -I dtb -O dts -o "$_live_dts" /sys/firmware/fdt 2>/dev/null \
        || { graft_warn "the live tree will not decompile"; return 0; }
    dtc -I dtb -O dts -o "$_asm_dts" "$1" 2>/dev/null \
        || { graft_warn "the profile's tree will not decompile"; return 0; }

    _mem=$(awk '/^\tmemory(@[0-9a-fA-F]+)? \{$/,/^\t\};$/' "$_live_dts")
    [ -n "$_mem" ] || { graft_warn "the live tree has no memory node"; return 0; }

    # As the root's LAST child: dtc has already written the root's properties, and a
    # property may not follow a node.
    awk -v mem="$_mem" '
        { line[NR] = $0; if ($0 == "};") last = NR }
        END {
            for (i = 1; i <= NR; i++) {
                if (i == last) print mem
                print line[i]
            }
        }
    ' "$_asm_dts" > "$_new_dts" || { graft_warn "the splice failed"; return 0; }
    dtc -I dts -O dtb -o "$_new_dtb" "$_new_dts" 2>/dev/null \
        || { graft_warn "the grafted tree will not compile"; return 0; }
    cat "$_new_dtb" > "$1"
    say "grafted this machine's memory node onto the profile's device tree"
}

DTB=$(mktemp /tmp/boot-profile.XXXXXX.dtb); TOP_TMPFILES="${TOP_TMPFILES:-} $DTB"
booted=$(findmnt -no FSROOT / 2>/dev/null); booted=${booted#/}
# The running profile's tree is the live one, but only when this really is the filesystem we booted
# from: profile names repeat across filesystems, so a card's @Desktop would otherwise be handed the
# internal @Desktop's device tree.
if ! target_fs_differs && [ "$arg" = "$booted" ] && [ -r /sys/firmware/fdt ]; then
    # the running profile: reuse the live, fully-assembled tree
    cat /sys/firmware/fdt > "$DTB"
else
    # base board dtb, chosen from the running board's first compatible
    # (e.g. "flipper,one-rev-f0b0c1" -> rk3576-flipper-one-rev-f0b0c1.dtb)
    if [ -n "$DT_REL" ]; then
        base="$TOP$DT_REL"
    else
        comp=$(tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | head -n1)
        board=$(printf '%s' "$comp" | tr ',' '-')
        base="$TOP$DTDIR_REL/rockchip/rk3576-$board.dtb"
    fi
    [ -f "$base" ] || die "base device tree not found: ${base#$TOP}"
    ovl=""
    for o in $OVL_REL; do ovl="$ovl $TOP$o"; done
    if [ -n "$ovl" ]; then
        fdtoverlay -i "$base" -o "$DTB" $ovl || die "fdtoverlay failed to apply overlays"
    else
        cp "$base" "$DTB"
    fi
    graft_firmware_memory "$DTB"
fi

# --kexec-syscall, or the tree assembled above is thrown away. kexec-tools defaults to
# kexec_file_load, and on that path arm64 discards a user-supplied dtb on purpose --
# `if (do_kexec_file_syscall) arm64_opts.dtb = NULL;` -- because the kernel builds the new
# tree from the running one. The old syscall runs the arm64 purgatory, which loads our dtb as
# a segment and enters the kernel with its address in x0.
#
# --no-checks with it, because that purgatory otherwise SHA-256s every segment before it
# branches: measured on this board, 12 of the 13.5 seconds between "Starting new kernel" and
# the new kernel's first console line, for 42MB of kernel and initrd. The digest is worth
# paying for a crash kernel loaded hours in advance; here the same tool wrote those segments
# milliseconds ago on a machine that is about to jump into them, with no firmware handoff and
# nothing else running in between.
kexec --kexec-syscall --no-checks -l "$K" ${I_REL:+--initrd="$I"} --dtb="$DTB" --command-line="$OPTS" \
    || die "kexec load failed"

if [ "$dry" = 1 ]; then
    kexec --kexec-syscall -u 2>/dev/null || true
    echo "boot-profile: $arg loaded OK and unloaded (dry run)"
    exit 0
fi

# `systemctl kexec` is the clean way over: services stop, filesystems are unmounted, and only
# then does the loaded image run. It needs systemd to ask, which a booted profile has and an
# initramfs does not.
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    say "kexec into $arg, handing over with systemctl kexec"
    exec systemctl kexec
fi

# No systemd to ask, so do by hand the little that still matters. The image is already in the
# kernel, so the assembled dtb and our own mount of the top level have done their job; drop them
# now, because `kexec -e` never returns and the EXIT trap would never run, leaving a mount for the
# new kernel to find dirty.
say "kexec into $arg, no systemd, jumping straight in"
top_cleanup
trap - EXIT INT TERM HUP

sync
kexec -e || die "kexec -e refused, though the load succeeded"
