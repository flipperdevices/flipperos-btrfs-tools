#!/bin/sh
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# Flipper One BLS boot-entry generator (kernel-install plugin, layout=bls).
#
# The kernel/initrd staging and devicetree(dir) handling are derived from systemd's
# 90-loaderentry.install (LGPL-2.1-or-later).
#
# Keys written: standard BLS (title, version, machine-id, sort-key, options, linux,
# devicetree, devicetree-overlay, initrd) plus 'devicetreedir' - a U-Boot extension
# (DTB directory for cross-board fdtdir auto-selection; a U-Boot alias of 'fdtdir').
#
# The shared entry-writing helpers live in /usr/lib/flipper-bls.sh (also sourced by the
# btrfs snapshot tooling: create_profile / rename_profile).

set -e
. /usr/lib/flipper-bls.sh

# ===========================================================================
# kernel-install plugin body.
# ===========================================================================
COMMAND="${1:?}"
KERNEL_VERSION="${2:?}"
ENTRY_DIR_ABS="${3:?}"

[ "$KERNEL_INSTALL_LAYOUT" = "bls" ] || exit 0

BOOT_ROOT="${KERNEL_INSTALL_BOOT_ROOT:?}"
ENTRY_TOKEN="${KERNEL_INSTALL_ENTRY_TOKEN:?}"
MACHINE_ID="${KERNEL_INSTALL_MACHINE_ID:-}"
CONF_ROOT="${KERNEL_INSTALL_CONF_ROOT:-/etc/kernel}"
ENTRIES="$BOOT_ROOT/loader/entries"
PROFILES="${FLIPPER_PROFILES:-/etc/kernel/flipper-profiles}"
resolve_kconfig
set_dtb_dirs
[ -n "${BOOT_MNT:-}" ] || BOOT_MNT="/"

# remove: drop every entry for THIS version that boots the CURRENT root subvol, whatever its
# entry-token (factory 'debian-*' and per-root 'flipperos-*' alike). Keyed on each entry's own
# content (version + rootflags=subvol=), so it never touches another profile's entries and
# survives any purge/cleanup path. kernel-install itself removes this root's staged dir.
if [ "$COMMAND" = "remove" ]; then
    remove_entries "$(booted_subvol)" "$KERNEL_VERSION"
    # kernel-install removed this version's staged dir; reap the now-empty per-token parent
    # ($BOOT_ROOT/$ENTRY_TOKEN) too. rmdir (not rm -rf) only succeeds if truly empty, so it
    # never touches a token dir that still has another version staged.
    rmdir "$BOOT_ROOT/$ENTRY_TOKEN" 2>/dev/null || :
    exit 0
fi
[ "$COMMAND" = "add" ] || exit 0

ENTRY_DIR="$(boot_rel "$ENTRY_DIR_ABS")"
mkdir -p "$ENTRIES" || die "could not create '$ENTRIES'"

# Base cmdline shared by every entry (profiles append their rootflags=subvol=).
compute_base_opts

# The os-release half of the sort-key (IMAGE_ID, else ID); the rest is composed below, once the
# root this entry is for is known.
SORT_KEY_OS="$(os_sort_key)"

# devicetree (single, optional): copied into the entry dir (the only thing that still uses it, so
# create it on demand rather than relying on kernel-install's core having made it).
DEVICETREE=""; DEVICETREE_ENTRY=""
[ -f "$CONF_ROOT/devicetree" ] && read -r DEVICETREE <"$CONF_ROOT/devicetree" || :
if [ -n "$DEVICETREE" ]; then
    mkdir -p "$ENTRY_DIR_ABS"
    for p in "$CONF_ROOT" $DTB_DIRS; do
        [ -f "$p/$DEVICETREE" ] || continue
        stage_file "$p/$DEVICETREE" "$ENTRY_DIR_ABS/${DEVICETREE##*/}"
        DEVICETREE_ENTRY="$ENTRY_DIR/${DEVICETREE##*/}"
        break
    done
    [ -n "$DEVICETREE_ENTRY" ] || die "device tree blob '$DEVICETREE' not found"
fi

# devicetreedir (U-Boot fdtdir extension) + overlay dir.
discover_devicetreedir

# Write this root's entry. apt/dpkg only ever touch the booted root, so emit ONLY its entry: match
# the booted root to a profile line for its title/overlays, else treat it as a clone (title = name).
CUR_SUBVOL="$(booted_subvol)"
[ -n "$CUR_SUBVOL" ] || die "cannot determine current root subvol (findmnt)"

# The key that places this entry in the boot order: this profile's autoboot digit and band as its
# existing entries have them, and rank 1 unless this is the profile's first kernel. Installing a
# kernel therefore never changes what boots -- it has to be chosen in Config first. The band comes
# from the entry token, which /etc/kernel/entry-token pins per profile.
SORT_KEY="$(entry_sort_key "$CUR_SUBVOL" "$(token_band "$ENTRY_TOKEN")")"

# kernel + initrd from this root's own /usr/lib/modules/<ver>/, else /boot (resolve_kernel_paths)
resolve_kernel_paths "$CUR_SUBVOL"

matched=0
if [ -f "$PROFILES" ]; then
    while IFS='|' read -r tok suf extra gate dtbos legend; do
        tok="$(echo "$tok" | tr -d '[:space:]')"
        case "$tok" in ''|\#*) continue ;; esac
        extra="$(trim "$extra")"
        if [ "$(subvol_of "$extra")" = "$CUR_SUBVOL" ]; then
            emit_entry "$(trim "$suf")" "$extra" "$(trim "$gate")" "$(trim "$dtbos")"
            matched=1; break
        fi
    done <"$PROFILES"
fi
if [ "$matched" != 1 ]; then
    # A clone (not a listed profile): inherit overlays from this profile's own existing BLS entry
    # (re-pointed to its subvol) plus its user drop-ins, so an apt kernel install keeps them instead
    # of dropping to a bare entry. Falls back to the base profile's overlays if it has no entry yet.
    ovl="$(clone_overlay_line "$BASE_OPTS rootflags=subvol=$CUR_SUBVOL" "$CUR_SUBVOL" "/")"
    emit_entry "$(printf '%s' "$CUR_SUBVOL" | tr -d '@')" "rootflags=subvol=$CUR_SUBVOL" "" "" "$ovl"
fi

exit 0
