#!/bin/sh
# boot-profile <@profile> - boot directly into a bootable PROFILE (as listed by list-profiles),
# skipping the firmware/U-Boot cycle. Reads the profile's BLS entry for the kernel, initrd and
# cmdline from the filesystem that profile is on rather than from /boot, so `-d` boots an SD card's
# profile with the card's own kernel.
#
# Two ways over, and the profile's own entry decides which:
#
#   pivot   For a profile whose kernel and device tree are the ones already running: put its
#           root in place and hand PID 1 over, skipping the 3.2s of kernel and initrd a boot
#           on this board costs. switch_root from the boot menu's initramfs, systemd's
#           soft-reboot from a booted profile.
#   kexec   Everything else, and the only way to boot a profile with a kernel or a device
#           tree of its own: assemble that device tree (the booted profile's is the live one,
#           any other profile's is the board base dtb + the entry's overlays via fdtoverlay),
#           load it with
#           kexec and hand over with `systemctl kexec` where systemd is running (clean shutdown,
#           nothing reserved) or `kexec -e` where it is not.
#
# Which one it took, or the exact reason pivot was refused, is always said out loud: to stderr and
# to /dev/kmsg. --dry-run reports the decision and validates whatever that decision needs without
# handing over: a pivot has nothing to load, so it stops there, and a kexec assembles the
# device tree and loads and unloads the image. --no-pivot forces kexec, which is also how to
# dry-run the kexec path on a machine that would pivot.
#
# The loading is also what a boot menu can do before it is asked to boot anything, since it is
# the slow part and it happens while the machine is idle: measured on this board a kexec boot
# spends 2.4s of its 13.8s loading, all of it inside the syscall, and none of that is reading
# files (0.08s cold) or assembling the device tree (0.04s). --arm does everything up to and
# including the load and stops; a later boot of the same profile finds its image already in the
# kernel and hands over at once. --disarm discards it. The kernel holds one image at a time, so
# only one profile can be armed, which is why the menu arms the one it would boot by itself.
set -eu
[ -r /usr/lib/flipper-btrfs.sh ] || { echo "Error: /usr/lib/flipper-btrfs.sh not found" >&2; exit 1; }
. /usr/lib/flipper-btrfs.sh

usage() {
    cat <<EOF
Usage: boot-profile [--dry-run] [--no-pivot] [-d|--device DEV] <@profile>
  Boot the profile: pivot into it where its kernel and device tree are already running
  (switch_root from an initramfs, systemctl soft-reboot from a booted profile), else load
  its BLS kernel/initrd/dtb and kexec, handing over with systemctl kexec under systemd and
  kexec -e without it.
  --dry-run   report the decision and validate it without rebooting: a pivot loads
              nothing, a kexec assembles + loads + unloads its image
  --no-pivot  never pivot, even where it would work
  --arm       load the image this profile would kexec into and stop there, so that a later
              boot of the same profile hands over without loading anything. Nothing to arm
              for a profile that would be pivoted into, and nothing is loaded then
  --disarm    discard an image left loaded by --arm. Takes no profile
$HELP_DEVICE
EOF
}

dry=0
no_pivot=0
arm=0
disarm=0
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)   dry=1 ;;
        --no-pivot)  no_pivot=1 ;;
        --arm)       arm=1 ;;
        --disarm)    disarm=1 ;;
        -d|--device) shift; need_device_arg "$#"; ROOTDEV=$1 ;;
        --device=*)  ROOTDEV=${1#*=} ;;
        -h|--help)   usage; exit 0 ;;
        --)          shift; break ;;
        -?*)         echo "Error: unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)           break ;;
    esac
    shift
done
# Where --arm records what it loaded, so a later boot can tell whether the image in the kernel
# is the one it wants. On tmpfs either side of a handover, which is what makes it truthful: a
# record surviving into the next boot would describe an image that is no longer loaded.
ARMED=/run/boot-profile.armed

# One image at a time, so discarding is unconditional: the kernel keeps a single kexec_image
# and there is nothing to name. EBUSY means another process holds the kexec lock, which is a
# load still running, so wait it out rather than report a failure it will not see again.
kexec_wait() {  # "$@" = the kexec invocation
    _n=0
    while ! "$@" 2>/dev/null; do
        _n=$((_n + 1))
        [ "$_n" -lt 40 ] || return 1
        sleep 0.1
    done
    return 0
}

if [ "$disarm" = 1 ]; then
    rm -f "$ARMED"
    if [ "$(cat /sys/kernel/kexec_loaded 2>/dev/null)" = 1 ]; then
        kexec_wait kexec --kexec-syscall -u || die "cannot discard the loaded image"
        echo "boot-profile: disarmed, the loaded image is discarded"
    else
        echo "boot-profile: nothing was loaded"
    fi
    exit 0
fi

[ "$arm" = 0 ] || [ "$dry" = 0 ] || die "--arm loads an image and --dry-run loads none"

[ $# -ge 1 ] || { usage >&2; exit 1; }
arg=$1
case "$arg" in *..*|/*) die "Invalid name: $arg" ;; esac

need_root

# Everything this decides is said out loud, to stderr for whoever ran it and to the kernel log
# for whoever reads the boot afterwards. A boot that picks one of two paths and does not say
# which is a boot nobody can debug from the log alone.
say() {
    echo "boot-profile: $*" >&2
    [ -w /dev/kmsg ] && echo "boot-profile: $*" > /dev/kmsg 2>/dev/null
    return 0
}

# BLS paths are top-level (/@X/...); read them under a subvolid=5 mount so this works for any
# profile, booted or not.
mount_top

# The entries belong to the filesystem the profile lives on, not to the one we booted from. For the
# booted filesystem $TOP/boot is the same subvolume that /boot already is, so this is the same file.
# For any other -- an SD card written with our own image -- it is that card's own entries, which is
# the only place its paths resolve: a card carries its own kernels, so an entry read from /boot
# names a version the card does not have, and profile names repeat across filesystems, so the wrong
# entry is found rather than none.
ENTRIES=$TOP/boot/loader/entries
# newest entry (highest kernel version sorts last) whose cmdline mounts this subvol
entry=$(grep -lE "rootflags=subvol=$arg( |\$)" "$ENTRIES"/*.conf 2>/dev/null | sort | tail -n1)
[ -n "$entry" ] || die "No boot entry for $arg (see list-profiles)"
val() { sed -n "s/^$1[[:space:]]\{1,\}//p" "$entry" | head -n1; }
K_REL=$(val linux); I_REL=$(val initrd); OPTS=$(val options)
DT_REL=$(val devicetree); DTDIR_REL=$(val devicetreedir); OVL_REL=$(val devicetree-overlay)
[ -n "$K_REL" ]  || die "boot entry has no 'linux' line"
[ -n "$OPTS" ]   || die "boot entry has no 'options' line"
K="$TOP$K_REL"; I="$TOP$I_REL"
[ -f "$K" ] || die "kernel not found: $K_REL"
[ -z "$I_REL" ] || [ -f "$I" ] || die "initrd not found: $I_REL"

# ── pivot, where the profile needs no kernel boot of its own ───────────────────
# A profile whose kernel and device tree are already running does not need a second one:
# put its root in place and hand PID 1 over. Measured on this board a full boot is 3.2s of
# kernel and initrd before userspace starts, and that is the part this skips.
#
# Two ways to hand over, because the two places this runs from are not alike:
#
#   switch_root   From the boot menu's initramfs. Not pivot_root: the root there is the
#                 kernel's rootfs, which cannot be moved aside, and switch_root is written
#                 for exactly that -- it moves /dev, /proc, /sys and /run across, frees the
#                 initramfs and execs the new init. The exec has to happen in PID 1 or the
#                 profile's systemd comes up as an ordinary process, and boot-profile is a
#                 grandchild of init, so the handover is init's: BusyBox execs its first
#                 `restart` action on SIGQUIT, after the shutdown actions and after killing
#                 every process, which is also what lets go of the panel. That action is the
#                 image's boot-pivot, and the request file names what to mount.
#   soft-reboot   From a booted profile. systemd will not switch root outside an initrd, and
#                 does not have to: soft-reboot is the supported way to replace userspace
#                 without touching the kernel. Mount the profile at /run/nextroot and ask;
#                 systemd stops everything, switches root there and re-executes itself as
#                 PID 1 inside it.
#
# Both keep the running kernel and the running device tree, so both ask the same three
# questions -- is this the kernel the entry names, does it want an overlay that is not applied,
# is the live device tree the one it names -- and answer the last one differently, because the
# two places know the live device tree differently:
#
#   From the initramfs there is no record of it. Falcon boots this image from a FIT carrying
#   U-Boot's control device tree, which describes this board but is not any file a profile
#   names: it is built from U-Boot's copy of the board source and carries U-Boot's own nodes.
#   So a profile naming any overlay is refused, since none is applied and a running kernel
#   cannot be given one, and one naming none has its dtb checked for the same board rather
#   than compared as source. The command line is not compared at all: it is the FIT's, so it
#   is nobody's profile, and a profile pivoted from the menu runs with the menu's parameters.
#   From a booted profile the record is that profile's own entry, so the two entries' device
#   trees are compared instead: paths, and the bytes of every overlay they name, since a path
#   means a different file in each root. Command lines are compared too, and any difference
#   either way refuses.
PIVOT_HELPER=/usr/bin/boot-pivot
PIVOT_REQ=/flipper-pivot

KREL=$(val version)
# Older entries carry no version line; the kernel path holds it either way.
[ -n "$KREL" ] || KREL=$(printf '%s' "$K_REL" | sed -n 's:.*/modules/\([^/]*\)/.*:\1:p')
RUNNING=$(uname -r)

# The board dtb this entry names: its own single 'devicetree' where it has one, else the file
# for the running board's first compatible inside its devicetreedir, e.g.
# "flipper,one-rev-f0b0c1" -> rockchip/rk3576-flipper-one-rev-f0b0c1.dtb.
base_dtb() {
    if [ -n "$DT_REL" ]; then printf '%s' "$TOP$DT_REL"; return 0; fi
    _comp=$(tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | head -n1)
    printf '%s' "$TOP$DTDIR_REL/rockchip/rk3576-$(printf '%s' "$_comp" | tr ',' '-').dtb"
}

# Which handover this machine can do, or nothing at all.
pivot_how() {
    if [ ! -d /run/systemd/system ]; then
        [ -x "$PIVOT_HELPER" ] && command -v switch_root >/dev/null 2>&1 && printf 'switch_root'
    else
        [ -f /usr/lib/systemd/system/soft-reboot.target ] && printf 'soft-reboot'
    fi
    return 0
}

# Where the profile's init is, relative to its root. Empty when it has none, which is a root
# that cannot be pivoted into whatever else is true of it.
pivot_init() {
    for _i in /sbin/init /usr/lib/systemd/systemd /lib/systemd/systemd; do
        [ -x "$TOP/$arg$_i" ] && { printf '%s' "$_i"; return 0; }
    done
    return 1
}

# The profile's own modules for the running kernel. A version string that matches is not the
# same as a root that can load a module, and this is the half that actually breaks.
pivot_modules() {
    for _d in "$TOP/$arg/usr/lib/modules/$RUNNING" "$TOP/$arg/lib/modules/$RUNNING"; do
        [ -f "$_d/modules.dep" ] && { printf '%s' "$_d"; return 0; }
    done
    return 1
}

# A command line reduced to what a pivot cannot change, sorted so two can be compared. root=
# and rootflags= name the root a pivot puts in place itself, and bootmenu= belongs to the menu
# image rather than to any profile.
norm_args() {
    printf '%s\n' "$1" | tr ' \t' '\n\n' | grep -v '^$' \
        | grep -vE '^(root|rootflags|bootmenu)=' | sort | tr '\n' ' '
}

# How the profile's command line differs from the one this boot got, or nothing when they
# agree. Both directions matter and neither can be fixed by a pivot: an argument the profile
# asks for it would not get, and one this boot has that the profile never asked for and would
# be stuck with.
cmdline_diff() {
    _want=$(norm_args "$OPTS")
    _have=$(norm_args "$(cat /proc/cmdline 2>/dev/null)")
    [ "$_want" = "$_have" ] && return 0
    _miss=""; _extra=""
    for _a in $_want; do case " $_have " in *" $_a "*) ;; *) _miss="$_miss $_a" ;; esac; done
    for _a in $_have; do case " $_want " in *" $_a "*) ;; *) _extra="$_extra $_a" ;; esac; done
    [ -z "$_miss" ]  || printf 'it asks for%s and this boot did not get %s' \
        "$_miss" "$([ "$(echo $_miss | wc -w)" = 1 ] && echo it || echo them)"
    [ -n "$_miss" ] && [ -n "$_extra" ] && printf '; '
    [ -z "$_extra" ] || printf 'this boot carries%s and it never asked for %s' \
        "$_extra" "$([ "$(echo $_extra | wc -w)" = 1 ] && echo it || echo them)"
}

# /@X/usr/lib/... -> /usr/lib/...: every entry prefixes its device tree paths with its own root
# subvol, because U-Boot reads the btrfs top level, so those prefixes always differ between
# two profiles and never mean a different device tree.
strip_subvol() {
    case "$1" in
        /@*/*) printf '/%s' "${1#/@*/}" ;;
        *)     printf '%s' "$1" ;;
    esac
}

# The device tree an entry asks for: one path per line, kind first, prefixes removed, sorted.
tree_spec() {
    sed -n 's/^devicetree[[:space:]]\{1,\}/dt /p
            s/^devicetreedir[[:space:]]\{1,\}/dtdir /p
            s/^devicetree-overlay[[:space:]]\{1,\}/ovl /p' "$1" \
    | while read -r _k _rest; do
          for _p in $_rest; do printf '%s %s\n' "$_k" "$(strip_subvol "$_p")"; done
      done | sort
}

# The overlays an entry names, prefixes intact so the files can be read, sorted the way
# tree_spec sorts them: within one entry every path shares a prefix, so this is the same order.
ovl_list() {
    sed -n 's/^devicetree-overlay[[:space:]]\{1,\}//p' "$1" | head -n1 \
        | tr ' ' '\n' | grep -v '^$' | sort
}

# The entry this system booted from: the profile mounted at / with the kernel that is running.
booted_entry() {
    _sv=$(findmnt -no FSROOT / 2>/dev/null); _sv=${_sv#/}
    [ -n "$_sv" ] || return 1
    for _e in "$ENTRIES"/*.conf; do
        [ -f "$_e" ] || continue
        grep -qE "rootflags=subvol=$_sv( |\$)" "$_e" 2>/dev/null || continue
        [ "$(sed -n 's/^version[[:space:]]\{1,\}//p' "$_e" | head -n1)" = "$RUNNING" ] || continue
        printf '%s' "$_e"; return 0
    done
    return 1
}

# A device tree without the parts the loader writes per boot, so two can be compared. /memory
# and /chosen are filled in from what the SoC reports and what the loader was told, and the
# memreserve directives describe this boot's initrd. None of them say which device tree this is.
strip_loader_nodes() {
    awk '
        /^\/memreserve\// { next }
        /^\t(memory(@[0-9a-fA-F]+)?|chosen|reserved-memory) \{$/ { skip = 1 }
        skip { if ($0 == "\t};") skip = 0; next }
        # Blank lines go too. dtc separates nodes with one, so removing a node above leaves
        # its blank behind and the two device trees differ by whitespace alone, which is what
        # refused every pivot from the boot menu until it was found: one newline.
        /^[[:space:]]*$/ { next }
        { print }
    ' "$1"
}

# Whether the live device tree is the one this file describes. Compared as source rather than bytes,
# because the loader edits nodes in place and a byte compare would only ever say no.
live_tree_is() {  # $1 = dtb file
    command -v dtc >/dev/null 2>&1 \
        || { printf 'no dtc to compare the live device tree with'; return 1; }
    [ -r /sys/firmware/fdt ] || { printf 'no /sys/firmware/fdt to compare against'; return 1; }
    _lv=$(mktemp /tmp/boot-profile.XXXXXX.lv.dts); _pf=$(mktemp /tmp/boot-profile.XXXXXX.pf.dts)
    TOP_TMPFILES="${TOP_TMPFILES:-} $_lv $_pf $_lv.s $_pf.s"
    dtc -I dtb -O dts -o "$_lv" /sys/firmware/fdt 2>/dev/null \
        || { printf 'the live device tree will not decompile'; return 1; }
    dtc -I dtb -O dts -o "$_pf" "$1" 2>/dev/null \
        || { printf 'the device tree %s names will not decompile' "$arg"; return 1; }
    strip_loader_nodes "$_lv" > "$_lv.s"; strip_loader_nodes "$_pf" > "$_pf.s"
    if ! cmp -s "$_lv.s" "$_pf.s"; then
        # Say what differs, not just that something does. Without this the refusal is
        # unactionable: the device tree is 10,000 lines and the difference has twice turned
        # out to be something trivial.
        say "device tree differs, live has: $(diff "$_pf.s" "$_lv.s" | grep '^[+>]' \
            | grep -v '^+++' \
            | head -3 | tr '\n' '|' | cut -c1-120)"
        say "device tree differs, file has: $(diff "$_pf.s" "$_lv.s" | grep '^[-<]' \
            | grep -v '^---' \
            | head -3 | tr '\n' '|' | cut -c1-120)"
        printf 'the live device tree is not the one %s names' "$arg"
        return 1
    fi
    return 0
}

# Whether the live device tree and this file describe the same board, which is as much as can
# be asked out of the boot menu. What Falcon hands that image is U-Boot's control device tree:
# built from U-Boot's own copy of the board source, carrying its nodes (binman, bootstd, dmc)
# and no overlay. Comparing it as source says no to every profile, and cannot even be
# attempted, since dtc refuses that blob outright: a binman template names a node @atf-SEQ,
# which is not a legal name. Comparing what the two claim to be is cheap, needs no dtc, and is
# the check that catches the failure worth catching -- the wrong board, or a card whose dtb
# belongs to another machine.
same_board() {  # $1 = dtb file
    command -v fdtget >/dev/null 2>&1 \
        || { printf 'no fdtget to identify the live device tree with'; return 1; }
    _lc=$(fdtget -ts /sys/firmware/fdt / compatible 2>/dev/null | tr '\n' ' ')
    _fc=$(fdtget -ts "$1" / compatible 2>/dev/null | tr '\n' ' ')
    [ -n "$_lc" ] || { printf 'the live device tree names no compatible'; return 1; }
    [ "$_lc" = "$_fc" ] || {
        printf 'the live device tree is %sand this one is %s' "$_lc" "$_fc"; return 1; }
    _lm=$(fdtget -ts /sys/firmware/fdt / model 2>/dev/null)
    _fm=$(fdtget -ts "$1" / model 2>/dev/null)
    [ "$_lm" = "$_fm" ] || {
        printf 'the live device tree is a %s and this one a %s' "$_lm" "$_fm"; return 1; }
    return 0
}

# Why the profile's device tree is not the running one, or nothing when it is. The two paths
# know the live device tree differently, so this is where they part.
tree_reason() {
    if [ "$PIVOT_HOW" = switch_root ]; then
        [ -z "$OVL_REL" ] || {
            printf 'it wants overlays (%s) and this image runs a device tree with none' \
                "$(for _o in $OVL_REL; do printf '%s ' "${_o##*/}"; done)"; return 0; }
        _base=$(base_dtb)
        [ -f "$_base" ] || { printf 'no base device tree at %s' "${_base#$TOP}"; return 0; }
        _why=$(same_board "$_base") || printf '%s (%s)' "$_why" "${_base#$TOP}"
        return 0
    fi
    _live=$(booted_entry) \
        || { printf 'cannot tell which entry this system booted from (root %s, kernel %s)' \
                 "$(findmnt -no FSROOT / 2>/dev/null)" "$RUNNING"; return 0; }
    [ "$(tree_spec "$_live")" = "$(tree_spec "$entry")" ] \
        || { printf 'its device tree is not the one running'; return 0; }
    _n=0
    _lo=$(ovl_list "$_live")
    for _tp in $(ovl_list "$entry"); do
        _n=$((_n + 1))
        _lp=$(printf '%s\n' $_lo | sed -n "${_n}p")
        cmp -s "$TOP$_lp" "$TOP$_tp" && continue
        printf 'overlay %s is not the one applied to the live device tree' "${_tp##*/}"
        return 0
    done
    return 0
}

# Why this profile cannot be pivoted into, or nothing at all when it can. One function, so the
# log can say exactly which rule sent a boot the long way round.
pivot_reason() {
    [ "$no_pivot" = 0 ] || { printf '%s' "--no-pivot"; return 0; }
    [ -n "$PIVOT_HOW" ] || { printf 'nothing here can hand PID 1 over'; return 0; }
    [ -n "$KREL" ] || { printf 'the entry names no kernel version'; return 0; }
    [ "$KREL" = "$RUNNING" ] \
        || { printf 'kernel %s, and %s is running' "$KREL" "$RUNNING"; return 0; }
    pivot_modules >/dev/null || { printf 'no modules for %s in %s' "$RUNNING" "$arg"; return 0; }
    pivot_init >/dev/null || { printf 'no init in %s' "$arg"; return 0; }
    _why=$(tree_reason); [ -z "$_why" ] || { printf '%s' "$_why"; return 0; }
    # Between two profiles, any difference at all, either way: they are booted the same way,
    # so a difference there is a profile asking for something specific, and pivoting anyway
    # would leave it running under a command line it never asked for.
    #
    # Out of the boot menu the comparison is not made. Falcon boots that image with the
    # bootargs built into the FIT, which are U-Boot's and not any profile's, so the answer
    # would always be no and never for a reason about this profile. What is checked instead is
    # what a wrong answer would actually break: the kernel version, the overlays, and that the
    # live device tree describes the same board as the dtb the entry names. A profile pivoted
    # from the menu therefore runs with the menu's kernel parameters, `quiet` and all.
    [ "$PIVOT_HOW" = switch_root ] || {
        _why=$(cmdline_diff); [ -z "$_why" ] || { printf '%s' "$_why"; return 0; }
    }
    return 0
}

# An image loaded by --arm, given back before a pivot hands over.
#
# A pivot keeps this kernel, and /run with it, so an image left loaded outlives the handover:
# it would sit in the new userspace holding its memory (measured 303MB) for a profile nobody
# is booting, with a record describing it that nothing will ever act on. It can only be for
# another profile, since arming one that would be pivoted into loads nothing at all.
drop_armed_image() {
    [ "$(cat /sys/kernel/kexec_loaded 2>/dev/null)" = 1 ] || { rm -f "$ARMED"; return 0; }
    rm -f "$ARMED"
    kexec_wait kexec --kexec-syscall -u || { say "could not discard the armed image"; return 0; }
    say "discarded the image armed for another profile: a pivot needs none"
}

# Mount nothing, load nothing: write down what init needs and ask it to take over.
pivot_switch_root() {
    drop_armed_image
    _init=$(pivot_init)
    say "pivot into $arg by switch_root: kernel $RUNNING and its device tree are live, init $_init"
    # In the initramfs root, not /run: the shutdown pass init runs before boot-pivot unmounts
    # /run, and rootfs is the one thing that survives it.
    printf 'DEV=%s\nSUBVOL=%s\nINIT=%s\n' "$ROOTDEV" "$arg" "$_init" > "$PIVOT_REQ" \
        || die "cannot write $PIVOT_REQ"
    # Ours goes now, while there is still something to unmount it with. boot-pivot mounts the
    # profile's root for itself and needs nothing of ours.
    top_cleanup
    trap - EXIT INT TERM HUP
    sync
    say "asking init to hand over: SIGQUIT, then boot-pivot as PID 1"
    kill -QUIT 1 || die "cannot signal init"
    # Init is on its way to killing us. Wait for it rather than exiting: an exit status here
    # would tell the menu the boot is over and put a screen back up over the handover.
    while : ; do sleep 1; done
}

# The profile goes at /run/nextroot and systemd does the rest.
pivot_soft_reboot() {
    drop_armed_image
    say "pivot into $arg with soft-reboot: kernel $RUNNING and its device tree stay up"
    mkdir -p /run/nextroot
    _err=$(mount -t btrfs -o "rw,subvol=$arg" "$ROOTDEV" /run/nextroot 2>&1) \
        || die "cannot mount $arg at /run/nextroot: $_err"
    # systemd tests this itself and quietly falls back to a full reboot when it fails, which
    # looks exactly like a pivot that was never tried. Say it here instead.
    [ -r /run/nextroot/etc/os-release ] || [ -r /run/nextroot/usr/lib/os-release ] || {
        umount /run/nextroot 2>/dev/null || true
        die "$arg carries no os-release, so systemd would not take it as a root"
    }
    # Ours must not survive into the new root: soft-reboot keeps /run, so a top-level mount
    # left here comes up inside the profile we are switching to.
    top_cleanup
    trap - EXIT INT TERM HUP
    sync
    say "handing over with systemctl soft-reboot"
    exec systemctl soft-reboot
}

PIVOT_HOW=$(pivot_how)
PIVOT_WHY=$(pivot_reason)
if [ -z "$PIVOT_WHY" ]; then
    # A dry run validates the path it just chose, and a pivot needs nothing loaded and no
    # device tree assembled: everything it depends on -- the kernel version, the profile's modules,
    # its init, the live device tree -- has been read already to get here. Going on to assemble a
    # device tree and load a kexec image would be proving the wrong path, at the cost of a
    # dtc round trip and a memory graft for a boot that would never use either.
    if [ "$dry" = 1 ]; then
        say "dry run: $arg would be pivoted into with $PIVOT_HOW; nothing loaded, nothing changed"
        say "dry run: add --no-pivot to prove the kexec path on this machine"
        exit 0
    fi
    # Arming is preparation for a boot, never a boot: a pivot has nothing to prepare, so say so
    # and stop. Without this the menu would boot the profile the moment it armed it.
    if [ "$arm" = 1 ]; then
        rm -f "$ARMED"
        # An image left over from arming something else has to go with the record. A pivot keeps
        # this kernel running, so it would otherwise sit there holding its memory for the rest of
        # the machine's life, armed for a profile nobody asked for.
        if [ "$(cat /sys/kernel/kexec_loaded 2>/dev/null)" = 1 ]; then
            kexec_wait kexec --kexec-syscall -u || true
            say "discarded the image armed earlier: $arg needs none"
        fi
        say "nothing to arm for $arg: a pivot with $PIVOT_HOW loads nothing"
        exit 0
    fi
    case "$PIVOT_HOW" in
        switch_root) pivot_switch_root ;;
        soft-reboot) pivot_soft_reboot ;;
    esac
else
    say "kexec into $arg rather than pivot: $PIVOT_WHY"
fi

# Graft this machine's /memory node onto an assembled device tree.
#
# A shipped dtb describes the board, not the board's RAM: U-Boot writes /memory at every
# cold boot from what the SoC reports, and a BLS entry cannot carry it. Without it a
# kernel has no memory at all and dies before it can initialise a console, which is a
# boot that hangs and says nothing. That node is also what keeps firmware safe: it starts
# at 0x40200000 while ATF loads below that, so the window handed to Linux excludes it.
#
# The live reserve map is deliberately NOT copied. It describes the boot that is running:
# measured on this board it is exactly the length of the initramfs U-Boot loaded, so it is
# a fact about that boot's initrd and not about the machine. kexec tells the new kernel
# where its own initrd is.
#
# Grafted rather than taking the live device tree whole, because a device tree belongs to its
# kernel: every entry names the devicetreedir installed beside the kernel it boots, and the live
# device tree is whatever kernel is running now. RAM is a fact about the machine and survives
# that difference.
#
# Best-effort, but never silent: a failure warns and the boot goes on, since a device tree with a
# memory node of its own is fine without us. Saying nothing is what let a broken splice sit
# in this function through several hangs, each looking exactly like the bug it fixes.
graft_warn() { say "$*, booting without this machine's memory node"; }

# The fast way: copy the live /memory node into the assembled device tree with libfdt, no text round
# trip. Measured on this board, 0.022s against 0.63s for decompile-splice-recompile, on a boot
# path where that was a fifth of everything before the jump.
#
# Copied, never constructed: the node's name is whatever the loader wrote (plain `memory` here,
# not `memory@40200000`) and its reg cells describe this machine's banks, so both are read from
# the live device tree and written back verbatim. Returns non-zero if any step fails, and the caller
# falls back to the dts splice below, which is slower but has booted this board for months.
graft_with_fdtput() {  # $1 = assembled dtb, edited in place
    command -v fdtput >/dev/null 2>&1 && command -v fdtget >/dev/null 2>&1 || return 1
    _node=$(fdtget -l /sys/firmware/fdt / 2>/dev/null | grep -m1 '^memory') || return 1
    [ -n "$_node" ] || return 1
    _reg=$(fdtget -t x /sys/firmware/fdt "/$_node" reg 2>/dev/null) || return 1
    [ -n "$_reg" ] || return 1
    _dt=$(fdtget -ts /sys/firmware/fdt "/$_node" device_type 2>/dev/null) || _dt=memory
    fdtput -c "$1" "/$_node" 2>/dev/null || return 1
    fdtput -ts "$1" "/$_node" device_type "$_dt" 2>/dev/null || return 1
    # shellcheck disable=SC2086
    fdtput -t x "$1" "/$_node" reg $_reg 2>/dev/null || return 1
    # Read it back rather than trust the writes: libfdt edits the blob in place, so unlike the
    # dts path there is no compile to catch a device tree this has broken.
    [ "$(fdtget -t x "$1" "/$_node" reg 2>/dev/null)" = "$_reg" ] || return 1
    return 0
}
graft_firmware_memory() {  # $1 = assembled dtb, edited in place
    [ -r /sys/firmware/fdt ] || return 0
    # A device tree that names its own memory needs nothing from us.
    ! fdtget -l "$1" / 2>/dev/null | grep -qE '^memory(@|$)' || return 0
    if graft_with_fdtput "$1"; then
        say "grafted this machine's memory node onto the profile's device tree"
        return 0
    fi
    say "fdtput could not graft the memory node, falling back to a dts round trip"
    command -v dtc >/dev/null 2>&1 || { graft_warn "no dtc"; return 0; }

    _live_dts=$(mktemp /tmp/boot-profile.XXXXXX.live.dts)
    _asm_dts=$(mktemp /tmp/boot-profile.XXXXXX.asm.dts)
    _new_dts=$(mktemp /tmp/boot-profile.XXXXXX.new.dts)
    _new_dtb=$(mktemp /tmp/boot-profile.XXXXXX.new.dtb)
    TOP_TMPFILES="${TOP_TMPFILES:-} $_live_dts $_asm_dts $_new_dts $_new_dtb"
    dtc -I dtb -O dts -o "$_live_dts" /sys/firmware/fdt 2>/dev/null \
        || { graft_warn "the live device tree will not decompile"; return 0; }
    dtc -I dtb -O dts -o "$_asm_dts" "$1" 2>/dev/null \
        || { graft_warn "the profile's device tree will not decompile"; return 0; }

    _mem=$(awk '/^\tmemory(@[0-9a-fA-F]+)? \{$/,/^\t\};$/' "$_live_dts")
    [ -n "$_mem" ] || { graft_warn "the live device tree has no memory node"; return 0; }

    # As the root's LAST child: dtc has already written the root's properties, and a
    # property may not follow a node.
    awk -v mem="$_mem" '
        { line[NR] = $0; if ($0 == "};") last = NR }
        END {
            for (i = 1; i <= NR; i++) {
                if (i == last) print mem
                print line[i]
            }
        }
    ' "$_asm_dts" > "$_new_dts" || { graft_warn "the splice failed"; return 0; }
    dtc -I dts -O dtb -o "$_new_dtb" "$_new_dts" 2>/dev/null \
        || { graft_warn "the grafted device tree will not compile"; return 0; }
    cat "$_new_dtb" > "$1"
    say "grafted this machine's memory node onto the profile's device tree"
}

# Only the kexec path needs these, and only now that pivot has been ruled out. Checked up
# front they refused a handover that never touches them: a profile installed from stock
# carries no kexec-tools, and on one of those the whole tool used to exit before it had
# looked at whether it could pivot instead.
command -v kexec      >/dev/null 2>&1 || die "kexec not installed (kexec-tools), and $arg cannot be pivoted into: $PIVOT_WHY"
command -v fdtoverlay >/dev/null 2>&1 || die "fdtoverlay not installed"

# Whether the image already in the kernel is the one this boot wants. --arm leaves a record of
# what it loaded; everything that would change the image is compared against it, and the flag
# is read too, since an image can be discarded without the record going with it.
armed_for() {  # $1 = profile
    [ -r "$ARMED" ] || return 1
    [ "$(cat /sys/kernel/kexec_loaded 2>/dev/null)" = 1 ] || return 1
    A_PROFILE=; A_DEV=; A_ENTRY=; A_KREL=; A_OPTS=; A_KERNEL=; A_INITRD=
    . "$ARMED"
    # Paths go in without the mount point they were read through: every run mounts the top
    # level somewhere new, so the recorded path would never match the next one.
    [ "$A_PROFILE" = "$1" ] && [ "$A_DEV" = "$ROOTDEV" ] && [ "$A_ENTRY" = "${entry#$TOP}" ] \
        && [ "$A_KREL" = "$KREL" ] && [ "$A_OPTS" = "$OPTS" ] \
        && [ "$A_KERNEL" = "$K_REL" ] && [ "$A_INITRD" = "$I_REL" ]
}

if armed_for "$arg"; then
    if [ "$arm" = 1 ]; then
        say "$arg is armed already: its image is loaded and nothing has changed"
        top_cleanup
        trap - EXIT INT TERM HUP
        exit 0
    fi
    say "kexec into $arg with the image --arm already loaded, nothing to assemble or load"
else
    DTB=$(mktemp /tmp/boot-profile.XXXXXX.dtb); TOP_TMPFILES="${TOP_TMPFILES:-} $DTB"
    booted=$(findmnt -no FSROOT / 2>/dev/null); booted=${booted#/}
    # The running profile's device tree is the live one, but only when this really is the filesystem
    # we booted from: profile names repeat across filesystems, so a card's @Desktop would otherwise
    # be handed the
    # internal @Desktop's device tree.
    if ! target_fs_differs && [ "$arg" = "$booted" ] && [ -r /sys/firmware/fdt ]; then
        # the running profile: reuse the live, fully-assembled device tree
        say "device tree: the live one, since $arg is what is running"
        cat /sys/firmware/fdt > "$DTB"
    else
        # base board dtb, chosen from the running board's first compatible
        # (e.g. "flipper,one-rev-f0b0c1" -> rk3576-flipper-one-rev-f0b0c1.dtb)
        base=$(base_dtb)
        [ -f "$base" ] || die "base device tree not found: ${base#$TOP}"
        say "device tree: assembling ${base#$TOP} plus $(set -- $OVL_REL; echo $#) overlay(s)"
        ovl=""
        for o in $OVL_REL; do ovl="$ovl $TOP$o"; done
        if [ -n "$ovl" ]; then
            fdtoverlay -i "$base" -o "$DTB" $ovl || die "fdtoverlay failed to apply overlays"
        else
            cp "$base" "$DTB"
        fi
        graft_firmware_memory "$DTB"
    fi

    # --kexec-syscall, or the device tree assembled above is thrown away. kexec-tools defaults to
    # kexec_file_load, and on that path arm64 discards a user-supplied dtb on purpose --
    # `if (do_kexec_file_syscall) arm64_opts.dtb = NULL;` -- because the kernel builds the new
    # device tree from the running one. The old syscall runs the arm64 purgatory, which loads our
    # dtb as
    # a segment and enters the kernel with its address in x0.
    #
    # --no-checks with it, because that purgatory otherwise SHA-256s every segment before it
    # branches: measured on this board, 12 of the 13.5 seconds between "Starting new kernel" and
    # the new kernel's first console line, for 42MB of kernel and initrd. The digest is worth
    # paying for a crash kernel loaded hours in advance; here the same tool wrote those segments
    # milliseconds ago on a machine that is about to jump into them, with no firmware handoff and
    # nothing else running in between.
    kexec_wait kexec --kexec-syscall --no-checks -l "$K" ${I_REL:+--initrd="$I"} \
        --dtb="$DTB" --command-line="$OPTS" || die "kexec load failed"

    if [ "$arm" = 1 ]; then
        printf "A_PROFILE='%s'\nA_DEV='%s'\nA_ENTRY='%s'\nA_KREL='%s'\nA_OPTS='%s'\n" \
            "$arg" "$ROOTDEV" "${entry#$TOP}" "$KREL" "$OPTS" > "$ARMED" \
            || die "cannot write $ARMED"
        printf "A_KERNEL='%s'\nA_INITRD='%s'\n" "$K_REL" "$I_REL" >> "$ARMED"
        say "armed $arg: its image is loaded and a boot of it now hands over straight away"
        # The assembled device tree is in the image already, and the mount was only needed to
        # read it. Both go, or an arm leaves a mount live until something else boots.
        top_cleanup
        trap - EXIT INT TERM HUP
        exit 0
    fi
fi

if [ "$dry" = 1 ]; then
    kexec --kexec-syscall -u 2>/dev/null || true
    echo "boot-profile: $arg loaded OK and unloaded (dry run)"
    exit 0
fi

# `systemctl kexec` is the clean way over: services stop, filesystems are unmounted, and only
# then does the loaded image run. It needs systemd to ask, which a booted profile has and an
# initramfs does not.
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    say "kexec into $arg, handing over with systemctl kexec"
    exec systemctl kexec
fi

# No systemd to ask, so do by hand the little that still matters. The image is already in the
# kernel, so the assembled dtb and our own mount of the top level have done their job; drop them
# now, because `kexec -e` never returns and the EXIT trap would never run, leaving a mount for the
# new kernel to find dirty.
say "kexec into $arg, no systemd, jumping straight in"
top_cleanup
trap - EXIT INT TERM HUP

# Anything else of ours still mounted belongs to a tool that has not finished: a size walk
# takes seconds and the menu can boot while one runs, so its top-level mount is still live
# with reads in flight. Drop them all, lazily where a reader holds one. The jump is
# committed by here, and the alternative is what the log shows: the disks go offline under
# a mounted filesystem and its reads fail on the way out.
for _m in $(awk '$3 == "btrfs" { print $2 }' /proc/self/mounts | sort -r); do
    umount "$_m" 2>/dev/null || umount -l "$_m" 2>/dev/null || true
done

sync
kexec -e || die "kexec -e refused, though the load succeeded"
