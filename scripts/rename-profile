#!/bin/sh
# rename-profile <@old> <@new> - rename a bootable PROFILE at the btrfs top level (as listed by
# list-profiles) and reissue its BLS boot entry under the new name. Both are top-level names
# (e.g. @Desktop-2). The profile keeps its contents and btrfs parent; only its name and boot
# entry change. Cannot rename the currently booted profile (boot into another first).
# Works via a subvolid=5 (top-level) mount.
#
# Example:
#   rename-profile @SourceProfile @DestinationProfile   # old -> new (keeps contents + parent)
set -eu
[ -r /usr/lib/flipper-btrfs.sh ] || { echo "Error: /usr/lib/flipper-btrfs.sh not found" >&2; exit 1; }
. /usr/lib/flipper-btrfs.sh

usage() {
    cat <<EOF
Usage: rename-profile [-d|--device DEV] <@old> <@new>
$HELP_DEVICE
  Rename a bootable profile at the btrfs top level (see list-profiles) and reissue
  its boot entry. Both are top-level names. Cannot rename the booted profile.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)    ASSUME_YES=1 ;;
        -d|--device) shift; need_device_arg "$#"; ROOTDEV=$1 ;;
        --device=*)  ROOTDEV=${1#*=} ;;
        -h|--help)   usage; exit 0 ;;
        --)          shift; break ;;
        -?*)         echo "Error: unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)           break ;;
    esac
    shift
done
[ $# -ge 2 ] || { usage >&2; exit 1; }
old=$1; new=$2

need_root
need_btrfs
case "$old" in *..*|/*|*/*) die "Invalid name: $old (top-level names only, e.g. @Desktop-2)" ;; esac
validate_profile_name "$new"
[ "$old" = "$new" ] && die "Old and new names are the same"
is_reserved_subvol "$new" && die "Refusing to use reserved name: $new"

set_lock
mount_top
cur_id=$(target_running_id)
[ -e "$TOP/$old" ] || die "No such profile: $old (see list-profiles)"
[ -e "$TOP/$new" ] && die "Target already exists: $new"
is_reserved_subvol "$old" && die "Refusing to rename reserved subvolume: $old"
info=$(btrfs subvolume show "$TOP/$old" 2>/dev/null) || die "Not a profile: $old"
old_id=$(get "$info" "Subvolume ID")
is_running_id "$old_id" "$cur_id" \
    && die "Refusing to rename the currently booted profile ($old); boot into another profile first"

# top-level dir entry: mv keeps UUID + btrfs parent
mv "$TOP/$old" "$TOP/$new"
echo "Renamed profile '$old' -> '$new'"

# Whether this profile is the one that boots by itself. The order lives in the entries, and the
# entries are about to be removed and reissued under the new name, so the digit has to be carried
# across by hand or a renamed profile would quietly stop being the one that boots.
_was_auto=1
if [ -r /usr/lib/flipper-blsname.sh ]; then
    . /usr/lib/flipper-blsname.sh
    ENTRIES="$TOP/boot/loader/entries"
    for _f in "$ENTRIES"/*.conf; do
        [ -f "$_f" ] || continue
        [ "$(entry_subvol_of "$_f")" = "$old" ] || continue
        [ "$(sort_key_field "$_f" auto)" = 0 ] && _was_auto=0
    done
fi

# drop old name's BLS entry + staging, reissue for <@new>; parent chain intact -> right band
with_bls "old boot entry not removed for $old" remove_root_entries "$old"
with_bls "boot entry not created for $new" flipper_write_entry "$new" "$TOP/$new"

# The reissued entry is the renamed profile's only one, so it is its chosen kernel; the autoboot
# digit is whatever the old name carried.
if [ "$_was_auto" = 0 ] && [ -r /usr/lib/flipper-blsname.sh ]; then
    for _f in "$ENTRIES"/*.conf; do
        [ -f "$_f" ] || continue
        [ "$(entry_subvol_of "$_f")" = "$new" ] || continue
        restamp_entry "$_f" 0 0 '-' "$TOP/$new"
        echo "kept '$new' as the profile that boots by itself"
    done
fi

# One commit for all of it: the old name's entries went, the new one's was written, and its
# sort-key may have been restamped after that. Until this, none of it is on the disk.
sync

echo "Reboot and pick '$new' from the boot menu to use it"
