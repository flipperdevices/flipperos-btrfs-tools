#!/bin/sh
# SPDX-License-Identifier: LGPL-2.1-or-later
#
# flipmeta - read and write the CBOR blob in the 4 MiB metadata partition.
#
# The partition holds TWO copies of the blob. Each copy is a zero-padded CBOR payload followed
# by an ASCII trailer in its last 512 bytes:
#
#     FLIPMETA <counter> <crc>
#
# <crc> is crc32b over the whole payload area followed by the "FLIPMETA <counter>" text itself,
# so a corrupted counter cannot pass validation and steer the choice below. Reads take the valid
# copy with the larger counter. Writes go to the OTHER one, payload first and trailer second, so
# a power cut mid-update leaves a copy that fails its CRC and is ignored, while the previous
# generation stays whole.
#
# The payload area is checksummed whole rather than up to a stored length, so a write rewrites
# all of it. cbordump then reports the zero padding as "garbage after the end of the content"
# and exits non-zero on every read, which is expected; a real decode failure is caught by
# validating its output as JSON rather than by its exit status.
#
# Writes are read-modify-update: the active blob is decoded, one key changes, and everything
# else is carried over untouched, including keys this version of the tool knows nothing about.
# Values therefore have to stay inside the CBOR subset that survives the JSON round trip, which
# is what cbordump -jM and json2cbor -M preserve (text, numbers of any width, byte strings,
# booleans, null, arrays and maps).
#
# Example:
#   flipmeta set reg HK             # store a string
#   flipmeta get boot               # print one key, exit 2 if it is absent
#   flipmeta set --json usb.debug true
set -eu
[ -r /usr/lib/flipper-btrfs.sh ] || { echo "Error: /usr/lib/flipper-btrfs.sh not found" >&2; exit 1; }
. /usr/lib/flipper-btrfs.sh

# GPT type of the metadata partition, as written by build-images.sh. This is the generic
# "Linux reserved" type rather than one of ours, so the search below is deliberately narrow.
TYPE_GUID=8da63339-0007-60c0-c436-083ac8230908
MAGIC=FLIPMETA
SLOT=$((2 * 1024 * 1024))
TRAILER=512
# The payload is read and written in 4 KiB units because the internal UFS is 4K-native and
# 512-byte transfers halve the read speed. That leaves the payload area a whole number of 4 KiB
# blocks, so a gap of SLOT - TRAILER - CAP bytes sits unused between it and the trailer.
BLK=4096
CAP=$(( (SLOT - TRAILER) / BLK * BLK ))
KEY_ABSENT=2

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

usage() {
    cat <<EOF
Usage: flipmeta [-d|--device DEV] [--force] COMMAND [KEY] [VALUE]
$HELP_DEVICE
  get [KEY]           print the whole blob as JSON, or one dotted KEY ($KEY_ABSENT if absent)
  set [--json] K V    store V under K, as a string unless --json is given
  del KEY             remove KEY
  show                counter and length of both copies
      --force         initialise even when both copies are damaged (discards them)
EOF
}

# Debian ships tinycbor's converter as tinycbor-json2cbor, Buildroot as json2cbor.
#
# NOT named json2cbor, however tempting: `command -v` answers for functions as well as
# binaries, so a shim by that name finds itself, calls itself, and dies of a stack
# overflow rather than saying anything. Debian hides that for as long as its prefixed
# name matches first; where the binary is named plainly, the shim shadows it.
j2c() {
    J2C=${J2C:-$(command -v tinycbor-json2cbor 2>/dev/null || command -v json2cbor 2>/dev/null || true)}
    [ -n "$J2C" ] || die "Command not installed: json2cbor (tinycbor-utils)"
    "$J2C" "$@"
}

# Every partition of our type on the system, as "PATH PARENTDISK SIZE". One lsblk answers both
# which partition to use and whether it is big enough; lsblk costs more than the reads do.
metadata_parts() {
    lsblk -rbno PATH,PARTTYPE,PKNAME,SIZE | awk -v t="$TYPE_GUID" '$2 == t && $3 != "" { print $1, $3, $4 }'
}

# Which partition to act on. -d/--device takes the same kind of value as the other tools (the
# flipperos root partition); a whole disk, the metadata partition itself, or a plain file also
# resolve. Without it, internal storage beats an SD card: a card flashed with a FlipperOS image
# carries the same partition type AND the same filesystem label, and this metadata belongs to
# the device rather than to whichever medium happens to be booted.
find_dev() {
    if [ -n "${ROOTDEV:-}" ] && [ -f "$ROOTDEV" ]; then
        DEV=$ROOTDEV SIZE=$(stat -Lc %s "$ROOTDEV")
        return
    fi
    all=$(metadata_parts)
    if [ -n "${ROOTDEV:-}" ]; then
        disk=$(lsblk -no PKNAME "$ROOTDEV" 2>/dev/null | head -1)
        [ -n "$disk" ] || disk=${ROOTDEV#/dev/}
        hits=$(printf '%s\n' "$all" | awk -v d="$disk" '$2 == d { print $1, $3 }')
        [ -n "$hits" ] || die "No partition of type $TYPE_GUID on /dev/$disk"
    else
        hits=$(printf '%s\n' "$all" | awk '$2 !~ /^mmcblk/ { print $1, $3 }')
        [ -n "$hits" ] || hits=$(printf '%s\n' "$all" | awk 'NF { print $1, $3 }')
        [ -n "$hits" ] || die "No partition of type $TYPE_GUID on this system"
    fi
    [ "$(echo "$hits" | grep -c .)" -eq 1 ] || die "Several metadata partitions ($(echo "$hits" | cut -d' ' -f1)), pick one with -d"
    DEV=${hits% *} SIZE=${hits#* }
}

# The type is a generic one and the copy offsets are absolute, so refuse anything that cannot
# hold both copies instead of writing past the end of it.
check_size() {
    [ "$SIZE" -ge $((SLOT * 2)) ] || die "$DEV holds $SIZE bytes, too few for two copies of $SLOT"
}

copy_off()    { [ "$1" -eq 0 ] && echo 0 || echo $SLOT; }
copy_blk()    { echo $(( $(copy_off "$1") / BLK )); }
trailer_blk() { echo $(( ($(copy_off "$1") + SLOT - TRAILER) / TRAILER )); }
crc()         { cksum -a crc32b | cut -d' ' -f1; }
payload()     { dd if="$DEV" bs=$BLK skip=$(copy_blk "$1") count=$((CAP / BLK)) 2>/dev/null; }
trailer()     { dd if="$DEV" bs=$TRAILER skip=$(trailer_blk "$1") count=1 2>/dev/null | tr -d '\0' | head -1; }

# "<counter> <crc>" from a copy's trailer, fails when the magic is not there. Reads 4 KiB and
# does not checksum anything, so the counters can be compared before paying for a payload read.
fields() {
    set -- $(trailer "$1")
    [ "${1:-}" = "$MAGIC" ] || return 1
    printf '%s %s' "${2:-}" "${3:-}"
}

# True when copy $1 checksums to $3 with counter $2. Takes the trailer fields rather than
# re-reading them, since every caller has just parsed them.
verify() {
    [ -n "${2:-}" ] || return 1
    _got=$( { payload "$1"; printf '%s' "$MAGIC $2"; } | crc )
    [ "$_got" = "$3" ]
}

# ACTIVE is the copy to read (empty if neither validates), TARGET the one to overwrite next.
# Only the newer copy is checksummed: if it validates it is the active one and the target is the
# other regardless of that other's state, so the usual path reads 2 MiB rather than 4.
survey() {
    VOK0= VOK1= ACTIVE=
    F0=$(fields 0) || F0=
    F1=$(fields 1) || F1=
    a=${F0% *} b=${F1% *}
    if [ -n "$a" ] && [ -n "$b" ]; then
        [ "$a" -ge "$b" ] && order='0 1' || order='1 0'
    elif [ -n "$a" ]; then order=0
    elif [ -n "$b" ]; then order=1
    else order=
    fi
    for c in $order; do
        if verify "$c" $(copy_fields "$c"); then
            [ "$c" -eq 0 ] && VOK0=1 || VOK1=1
            ACTIVE=$c
            break
        fi
        [ "$c" -eq 0 ] && VOK0=0 || VOK1=0
    done
    if [ -n "$ACTIVE" ]; then
        TARGET=$((1 - ACTIVE))
        [ "$ACTIVE" -eq 0 ] && NEXT=$((a + 1)) || NEXT=$((b + 1))
    else
        TARGET=0 NEXT=1
    fi
}

copy_fields() { case $1 in 0) echo "$F0" ;; 1) echo "$F1" ;; esac; }

# Validity marker for show, checksumming only what survey did not have to.
marker() {
    case $1 in
        0) _v=$VOK0 ;;
        1) _v=$VOK1 ;;
    esac
    [ -n "$_v" ] || { verify "$1" $(copy_fields "$1") && _v=1 || _v=0; }
    [ "$_v" = 1 ] || printf ' [does not validate]'
}

blank() { [ "$(dd if="$DEV" bs=$BLK count=$((SLOT / BLK * 2)) 2>/dev/null | tr -d '\0' | wc -c)" -eq 0 ]; }

# Sets JSON from the active copy. Must run in this shell: survey's results are needed by store.
load() {
    need_cmd cbordump tinycbor-utils
    survey
    if [ -z "$ACTIVE" ]; then
        blank || [ "${FORCE:-}" = 1 ] || die "Both copies are damaged, recover them by hand or pass --force"
        JSON='{}'
        return
    fi
    payload "$ACTIVE" > "$WORK/active.cbor"
    JSON=$(cbordump -jM "$WORK/active.cbor" 2>/dev/null) || true
    printf '%s' "$JSON" | jq -e . >/dev/null 2>&1 || die "The active copy does not decode, refusing to write a partial blob"
}

# Encode and land a new generation in TARGET. Payload first, trailer second, each flushed.
store() {
    printf '%s' "$1" > "$WORK/new.json"
    j2c -M "$WORK/new.json" > "$WORK/new.cbor" || die "Re-encoding the blob failed"
    len=$(stat -c %s "$WORK/new.cbor")
    [ "$len" -le "$CAP" ] || die "Blob of $len bytes does not fit in $CAP"
    head="$MAGIC $NEXT"
    cp "$WORK/new.cbor" "$WORK/padded"
    truncate -s "$CAP" "$WORK/padded"
    sum=$( { cat "$WORK/padded"; printf '%s' "$head"; } | crc )
    dd if="$WORK/padded" of="$DEV" bs=$BLK seek=$(copy_blk "$TARGET") conv=notrunc status=none
    sync
    printf '%s %s\n' "$head" "$sum" | dd of="$DEV" bs=$TRAILER seek=$(trailer_blk "$TARGET") conv=notrunc,sync status=none
    sync
}

while [ $# -gt 0 ]; do
    case "$1" in
        -d|--device) shift; need_device_arg "$#"; ROOTDEV=$1 ;;
        --device=*)  ROOTDEV=${1#*=} ;;
        --force)     FORCE=1 ;;
        -h|--help)   usage; exit 0 ;;
        -?*)         echo "Error: unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)           break ;;
    esac
    shift
done

cmd=${1:-}; [ $# -gt 0 ] && shift
need_root
find_dev
check_size
exec 9>>"$DEV"

case "$cmd" in
    get)
        need_cmd jq
        [ $# -le 1 ] || die "get takes one key at most"
        flock -s 9; load
        [ $# -eq 1 ] || { printf '%s\n' "$JSON"; exit 0; }
        printf '%s' "$JSON" | jq -e --arg p "$1" 'getpath($p | split(".")) != null' >/dev/null || exit $KEY_ABSENT
        printf '%s' "$JSON" | jq -r --arg p "$1" 'getpath($p | split("."))'
        ;;
    set)
        need_cmd jq
        if [ "${1:-}" = --json ]; then
            shift; [ $# -eq 2 ] || { usage >&2; exit 1; }
            value=$(printf '%s' "$2" | jq -c .) || die "Not valid JSON: $2"
        else
            [ $# -eq 2 ] || { usage >&2; exit 1; }
            value=$(jq -Rn --arg v "$2" '$v')
        fi
        flock 9; load
        store "$(printf '%s' "$JSON" | jq -c --arg p "$1" --argjson v "$value" 'setpath($p | split("."); $v)')"
        ;;
    del)
        need_cmd jq
        [ $# -eq 1 ] || { usage >&2; exit 1; }
        flock 9; load
        store "$(printf '%s' "$JSON" | jq -c --arg p "$1" 'delpaths([$p | split(".")])')"
        ;;
    show)
        flock -s 9; survey
        echo "Device: $DEV"
        echo "Active: ${ACTIVE:-none}, next write goes to copy $TARGET as counter $NEXT"
        printf 'copy 0: %s%s\n' "$(trailer 0)" "$(marker 0)"
        printf 'copy 1: %s%s\n' "$(trailer 1)" "$(marker 1)"
        ;;
    ''|*)
        echo "Error: unknown command: ${cmd:-none}" >&2; usage >&2; exit 1 ;;
esac
